{
  "manifest_version": 3,
  "name": "VideoGrabber",
  "version": "2.0.0",
  "description": "Pop any video on the page into Picture-in-Picture mode.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VideoGrabber"
  }
}
